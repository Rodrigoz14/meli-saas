{
  "manifest_version": 3,
  "name": "MeliBoost",
  "version": "0.2.0",
  "description": "Conecta tu cuenta de Mercado Libre para ver los datos reales de tus productos (ventas, stock, CTR de Ads) y busca nichos, todo desde el panel de tu navegador.",
  "permissions": ["scripting", "tabs", "storage", "sidePanel"],
  "host_permissions": [
    "*://*.mercadolibre.com/*",
    "*://*.mercadolibre.com.co/*",
    "*://*.mercadolibre.com.ar/*",
    "*://*.mercadolibre.com.mx/*",
    "*://*.mercadolibre.com.br/*",
    "*://*.mercadolibre.cl/*",
    "*://*.mercadolibre.com.pe/*",
    "http://localhost:3000/*",
    "https://meli-saas.vercel.app/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MeliBoost (clic para abrir el panel)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/*", "https://meli-saas.vercel.app/*"],
      "js": ["content-scripts/bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
